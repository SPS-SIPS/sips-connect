# Node A Environment (Reviewer Topology)
SIPS_CONNECT_PORT=8080
SIPS_CONNECT_HTTPS_PORT=9443
SIPS_COREBANK_PORT=8081
SIPS_POSTGRES_PORT=5432

# Participant Identity
BANK_CODE=ZKBASOS0
ACQUIRER_ID=0000
FI_TYPE=01
FI_NAME="Reviewer Bank A"

# CoreBank Integration (Internal to Stack A)
COREBANK_BASE_URL=http://sips-corebank-a:8080

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=SIPS.Connect.DB.A

# Reviewer Toggles
WITHOUT_PKI=true

# REQUIRED for two-node local peer simulation (Points to Node B)
# DO NOT set to local self-routing URL
SIPS_PEER_URL=http://host.docker.internal:9080/api/v1/incoming

Test_CoreBank_API_Key=api_key
Test_CoreBank_API_Secret=api_secret