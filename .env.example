# SIPS Reviewer Environment Configuration

# Service Ports
SIPS_CONNECT_PORT=8080
SIPS_CONNECT_HTTPS_PORT=9443
SIPS_COREBANK_PORT=8081

# Participant Identity (Bank Details)
BANK_CODE=ZKBASOS0
ACQUIRER_ID=0000
FI_TYPE=01
FI_NAME="Reviewer Bank"

# Backend callback integration
# SIPS Connect calls exactly one backend per deployment.
#
# CoreBank mock defaults:
ISO20022_VERIFICATION_URL=http://sips-corebank:8080/api/cb/verify
ISO20022_TRANSFER_URL=http://sips-corebank:8080/api/CB/Transfer
ISO20022_RETURN_URL=http://sips-corebank:8080/api/CB/Return
ISO20022_STATUS_URL=http://sips-corebank:8080/api/CB/Status
ISO20022_COMPLETION_NOTIFICATION_URL=http://sips-corebank:8080/api/CB/CompletionNotification

# P2G UAT callback backend:
# ISO20022_VERIFICATION_URL=https://10.128.200.244:8991/api/v1/sips-connect/verify
# ISO20022_TRANSFER_URL=https://10.128.200.244:8991/api/v1/sips-connect/payments/confirm
# ISO20022_RETURN_URL=https://10.128.200.244:8991/api/v1/sips-connect/payments/reverse
# ISO20022_STATUS_URL=https://10.128.200.244:8991/api/v1/sips-connect/payments/status
# ISO20022_COMPLETION_NOTIFICATION_URL=https://10.128.200.244:8991/api/v1/sips-connect/payments/confirm
# PAYER_BANK_CODE=ZKBASOS0
# PAYER_CHANNEL=MOBILE

# P2G callback OAuth client-credentials auth:
# CALLBACK_AUTH_ENABLED=true
# CALLBACK_TOKEN_ENDPOINT=https://<keycloak-host>/realms/<realm>/protocol/openid-connect/token
# CALLBACK_CLIENT_ID=sips-connect-p2g
# CALLBACK_CLIENT_SECRET=<secret>
# CALLBACK_SCOPE=
# CALLBACK_AUDIENCE=sps-p2g-gateway

# SIPS Core Discovery (Optional, used if WITHOUT_PKI=false)
# SIPS_CORE_BASE_URL=
# SIPS_CORE_PUBLIC_KEYS_REP_URL=
# SIPS_CORE_LOGIN_ENDPOINT=/login
# SIPS_CORE_LIVE_PARTICIPANTS_ENDPOINT=/api/v1/LiveParticipants
# SIPS_CORE_BALANCE_STATUS_ENDPOINT=/api/v1/BalanceStatus
# SIPS_CORE_USERNAME=
# SIPS_CORE_PASSWORD=
# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=SIPS.Connect.DB
DB_PORT=5432

# Reviewer-Specific Toggles
# Set to 'true' to bypass XAdES signing for simplified flow verification
WITHOUT_PKI=true

# PAPSS-facing integration (disabled by default)
# BANK_CODE is also used as Xades:BIC and becomes the signed WP-SIPS BAH From.
PAPSS_ENABLED=false
PAPSS_ISO_INGRESS_URL=https://<PAPSS-SERVICE-HOST>/sips/messages
PAPSS_ALLOWED_HOST=<PAPSS-SERVICE-HOST>
PAPSS_ENVIRONMENT=UAT
PAPSS_REMOTE_IDENTITY=<PAPSS-WP-SIPS-IDENTITY>
PAPSS_SECURITY_PROFILE=<WP-SIPS-BUSINESS-SERVICE>
PAPSS_REQUEST_TIMEOUT_SECONDS=30
PAPSS_MAXIMUM_RESPONSE_BYTES=2000000
PAPSS_READINESS_STALE_SECONDS=300
PAPSS_SPS_POLICY_LOCAL_INSTRUMENT=
PAPSS_LOCAL_COUNTRY=<ISO-3166-ALPHA-2>
PAPSS_SENDING_CURRENCY=<ISO-4217>

# Local participant callback routing. PAPSS is controlled by PAPSS_ENABLED.
PAPSS_CALLBACK_MAPPING_PROFILE=papss-callback-v1
PAPSS_CALLBACK_URL=https://<BANK-INTERNAL-HOST>/<CALLBACK-PATH>

# PAPSS operation store (docs/PAPSS_OPERATION_STORE_CONFIG.md). Everything is optional.
# UNRESOLVED PAPSS values: leave empty unless PAPSS publishes them. The deadline is record-only
# (logged/metric, exposed on lookups); no automatic negative reply exists. If you set a UAT
# value for observation, mark it: provisional; not established for acmt.023.
PAPSS_ACMT023_RESPONSE_DEADLINE_SECONDS=
# SourceCreationTime | ReceivedAt (set together with the value above, or leave both empty)
PAPSS_ACMT023_DEADLINE_CLOCK=
# Submit (default, unchanged behaviour) | Hold (do not submit a reply that is past its recorded deadline)
PAPSS_LATE_RESPONSE_POLICY=Submit
# Empty = pending outbound verifications never auto-expire (lookups report ageSeconds)
PAPSS_VERIFICATION_RESULT_EXPIRY_SECONDS=
# Empty = never purge the PAPSS operation store
PAPSS_STORE_RETENTION_DAYS=
PAPSS_STORE_PURGE_INTERVAL_MINUTES=60
# SPS-internal operational defaults for the bank push / gateway reply outboxes (not PAPSS rules)
PAPSS_DELIVERY_MAX_ATTEMPTS=10
PAPSS_DELIVERY_INITIAL_BACKOFF_SECONDS=5
PAPSS_DELIVERY_MAX_BACKOFF_SECONDS=300
PAPSS_DELIVERY_POLL_INTERVAL_SECONDS=5
PAPSS_DELIVERY_CLAIM_LEASE_SECONDS=120
# 0 = GET .../Operations/{id}?waitSeconds= long-polling disabled
PAPSS_LOOKUP_MAX_WAIT_SECONDS=0

# REQUIRED for single-node: set to Switch UAT or Production incoming API URL
# DO NOT set to localhost or http://sips-connect:8080/...
SIPS_SWITCH_URL=<your-switch-uat-or-prod-url>

Test_CoreBank_API_Key=api_key
Test_CoreBank_API_Secret=api_secret
