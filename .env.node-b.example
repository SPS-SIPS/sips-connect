# Node B Environment (Reviewer Topology)
SIPS_CONNECT_PORT=9080
SIPS_CONNECT_HTTPS_PORT=10443
SIPS_COREBANK_PORT=9081
SIPS_POSTGRES_PORT=6432

# Participant Identity
BANK_CODE=BKBASOS0
ACQUIRER_ID=1111
FI_TYPE=01
FI_NAME="Reviewer Bank B"

# CoreBank Integration (Internal to Stack B)
COREBANK_BASE_URL=http://sips-corebank-b:8080

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=SIPS.Connect.DB.B

# Reviewer Toggles
WITHOUT_PKI=true

# REQUIRED for two-node local peer simulation (Points to Node A)
# DO NOT set to local self-routing URL
SIPS_PEER_URL=http://host.docker.internal:8080/api/v1/incoming

Test_CoreBank_API_Key=api_key
Test_CoreBank_API_Secret=api_secret