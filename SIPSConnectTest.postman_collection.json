    {
      "name": "Transfer",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.collectionVariables.get(\"accountName\")) {",
              "    throw new Error(\"Missing required configuration: accountName\");",
              "}",
              "if (!pm.collectionVariables.get(\"account\")) {",
              "    throw new Error(\"Missing required configuration: account\");",
              "}",
              "if (!pm.collectionVariables.get(\"creditorAccountType\")) {",
              "    throw new Error(\"Missing required configuration: creditorAccountType\");",
              "}",
              "if (!pm.collectionVariables.get(\"agent\")) {",
              "    throw new Error(\"Missing required configuration: agent\");",
              "}",
              "",
              "if (!pm.collectionVariables.get(\"crIssuer\")) {",
              "    throw new Error(\"Missing required configuration: crIssuer\");",
              "}",
              "",
              "if (!pm.collectionVariables.get(\"defaultCurrency\")) {",
              "    throw new Error(\"Missing required configuration: defaultCurrency\");",
              "}",
              "",
              "const predefinedCategories = [\"C2CCRT\", \"C2CRTP\", \"C2BBPT\", \"C2BSQR\", \"C2BDQR\", \"C2BRTP\"];",
              "const predefinedInstruments = [\"CRTRM\", \"CRTAM\"];",
              "",
              "// Parse the request payload to get user-inserted values",
              "let payload = {};",
              "try {",
              "    payload = pm.request.body && pm.request.body.raw ? JSON.parse(pm.request.body.raw) : {};",
              "} catch (e) {",
              "    throw new Error(\"Invalid JSON in request body.\");",
              "}",
              "",
              "if (!predefinedCategories.includes(payload.ctgPurp)) {",
              "    throw new Error(`Invalid category: ${payload.ctgPurp}. Valid categories are: ${predefinedCategories.join(\", \")}`);",
              "}",
              "",
              "if (!predefinedInstruments.includes(payload.lclInstrument)) {",
              "    throw new Error(`Invalid instrument: ${payload.lclInstrument}. Valid instruments are: ${predefinedInstruments.join(\", \")}`);",
              "}",
              "// set the request payload properties",
              "const localIdPrefix = \"{{agent}}\";",
              "const localIdSuffix = Math.floor(Math.random() * 100000000).toString().padStart(8, '0');",
              "payload.localId = localIdPrefix + localIdSuffix;",
              "if (!payload.amount) {",
              "    payload.amount = Math.floor(Math.random() * 9999) + 1;",
              "}",
              "// sender",
              "payload.drName = pm.collectionVariables.get(\"accountName\");",
              "payload.drAccount = pm.collectionVariables.get(\"account\");",
              "payload.drAccountType = pm.collectionVariables.get(\"accountType\");",
              "// receiver",
              "payload.crName = pm.collectionVariables.get(\"creditorName\");",
              "payload.crAccount = pm.collectionVariables.get(\"creditorAccount\");",
              "payload.crAccountType = pm.collectionVariables.get(\"creditorAccountType\");",
              "payload.crAgentBIC = pm.collectionVariables.get(\"agent\");",
              "",
              "payload.lclInstrument = payload.lclInstrument || \"Postman\";",
              "payload.ctgPurp = payload.ctgPurp || \"C2CCRT\";",
              "payload.narration = payload.narration || \"Test Transaction\";",
              "payload.crIssuer = pm.collectionVariables.get(\"crIssuer\");",
              "payload.currency = pm.collectionVariables.get(\"defaultCurrency\");",
              "payload.agent = pm.collectionVariables.get(\"agent\");",
              "// update the request",
              "pm.request.body.raw = JSON.stringify(payload);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
