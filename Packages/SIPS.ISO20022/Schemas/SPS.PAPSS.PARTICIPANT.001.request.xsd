<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="urn:sps:papss:participant:001:request"
  targetNamespace="urn:sps:papss:participant:001:request" elementFormDefault="qualified">
  <xs:simpleType name="PapssId"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="35"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Bic"><xs:restriction base="xs:string"><xs:pattern value="[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ParticipantType"><xs:restriction base="xs:string"><xs:enumeration value="ADMINISTRATOR"/><xs:enumeration value="CENTRAL_BANK"/><xs:enumeration value="BANK"/><xs:enumeration value="MOBILE_NETWORK_OPERATOR"/><xs:enumeration value="VIRTUAL_ACCOUNT_OPERATOR"/><xs:enumeration value="CARD_OPERATOR"/></xs:restriction></xs:simpleType>
  <xs:complexType name="ListFilter"><xs:sequence><xs:element name="Online" type="xs:boolean" minOccurs="0"/><xs:element name="Type" type="ParticipantType" minOccurs="0"/></xs:sequence></xs:complexType>
  <xs:element name="ParticipantDiscoveryRequest"><xs:complexType><xs:choice>
    <xs:element name="List" type="ListFilter"/>
    <xs:element name="ByBic" type="Bic"/>
    <xs:element name="ByPapssId" type="PapssId"/>
  </xs:choice></xs:complexType></xs:element>
</xs:schema>
