<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="urn:sps:papss:readiness:001:request"
  targetNamespace="urn:sps:papss:readiness:001:request" elementFormDefault="qualified">
  <xs:simpleType name="PapssId"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="35"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Bic"><xs:restriction base="xs:string"><xs:pattern value="[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?"/></xs:restriction></xs:simpleType>
  <xs:element name="ParticipantReadinessRequest"><xs:complexType><xs:choice><xs:element name="PapssId" type="PapssId"/><xs:element name="Bic" type="Bic"/></xs:choice></xs:complexType></xs:element>
</xs:schema>
