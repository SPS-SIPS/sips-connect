<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns="urn:sps:papss:readiness:001:response"
  targetNamespace="urn:sps:papss:readiness:001:response" elementFormDefault="qualified">
  <xs:simpleType name="Text35"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="35"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Text350"><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="350"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="CurrencyCode"><xs:restriction base="xs:string"><xs:pattern value="[A-Z]{3}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Bic"><xs:restriction base="xs:string"><xs:pattern value="[A-Z0-9]{4}[A-Z]{2}[A-Z0-9]{2}([A-Z0-9]{3})?"/></xs:restriction></xs:simpleType>
  <xs:complexType name="Observation"><xs:sequence>
    <xs:element name="PapssId" type="Text35"/><xs:element name="Bic" type="Bic" minOccurs="0"/><xs:element name="Status" type="Text35"/><xs:element name="Online" type="xs:boolean"/><xs:element name="NonInstant" type="xs:boolean"/>
    <xs:element name="Currency" type="CurrencyCode" minOccurs="0" maxOccurs="unbounded"/><xs:element name="PaymentSchema" type="Text350" minOccurs="0" maxOccurs="unbounded"/>
  </xs:sequence></xs:complexType>
  <xs:complexType name="Error"><xs:sequence><xs:element name="Code" type="Text35"/><xs:element name="Description" type="Text350" minOccurs="0"/></xs:sequence><xs:attribute name="authority" use="required"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="PAPSS"/><xs:enumeration value="SPS"/></xs:restriction></xs:simpleType></xs:attribute></xs:complexType>
  <xs:element name="ParticipantReadinessResponse"><xs:complexType><xs:choice><xs:element name="Observation" type="Observation"/><xs:element name="Error" type="Error"/></xs:choice></xs:complexType></xs:element>
</xs:schema>
